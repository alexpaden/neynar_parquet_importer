FROM postgres:16

# Install necessary system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    postgresql-server-dev-16 \
    python3 \
    python3-pip \
    python3-venv \
    libssl-dev \
    pkg-config \
    curl \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set PG_CONFIG for Postgres 16
ENV PG_CONFIG=/usr/bin/pg_config

# Install pgvector
RUN cd /tmp && \
    git clone --branch v0.8.0 https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make USE_PGXS=1 PG_CONFIG=$PG_CONFIG && \
    make install PG_CONFIG=$PG_CONFIG && \
    rm -rf /tmp/pgvector

# Add plpython3u before pgai
RUN apt-get update && apt-get install -y postgresql-plpython3-16 && \
    mkdir -p /docker-entrypoint-initdb.d

# Create initialization script for schemas
RUN echo 'CREATE SCHEMA IF NOT EXISTS farcaster;' > /docker-entrypoint-initdb.d/00_init_schemas.sql && \
    echo 'CREATE SCHEMA IF NOT EXISTS nindexer;' >> /docker-entrypoint-initdb.d/00_init_schemas.sql && \
    echo 'CREATE SCHEMA IF NOT EXISTS unbias;' >> /docker-entrypoint-initdb.d/00_init_schemas.sql

# Create initialization script for all extensions
RUN echo 'CREATE EXTENSION IF NOT EXISTS plpython3u;' > /docker-entrypoint-initdb.d/01_init_extensions.sql && \
    echo 'CREATE EXTENSION IF NOT EXISTS vector;' >> /docker-entrypoint-initdb.d/01_init_extensions.sql && \
    echo 'CREATE EXTENSION IF NOT EXISTS pg_cron;' >> /docker-entrypoint-initdb.d/01_init_extensions.sql && \
    echo 'CREATE EXTENSION IF NOT EXISTS http;' >> /docker-entrypoint-initdb.d/01_init_extensions.sql && \
    echo 'CREATE EXTENSION IF NOT EXISTS pgai;' >> /docker-entrypoint-initdb.d/01_init_extensions.sql && \
    echo 'CREATE EXTENSION IF NOT EXISTS pg_tiktoken;' >> /docker-entrypoint-initdb.d/01_init_extensions.sql

# -----------------------------------------------------------------------------
# Install pgai with proper dependencies and paths
# -----------------------------------------------------------------------------
# Install Python dependencies needed by pgai
RUN apt-get update && apt-get install -y \
    python3-dev \
    python3-setuptools \
    && rm -rf /var/lib/apt/lists/*

# Clone and install pgai
RUN git clone https://github.com/timescale/pgai.git /tmp/pgai && \
    cd /tmp/pgai/projects/extension && \
    # Create and activate virtual environment
    python3 -m venv venv && \
    . venv/bin/activate && \
    # Install uv package manager
    pip install --no-cache-dir uv==0.5.20 && \
    # Set PostgreSQL paths
    export PGCONFIG=/usr/bin/pg_config && \
    export POSTGRES_HOME=/usr/lib/postgresql/16 && \
    # Build and install pgai
    python3 build.py build && \
    python3 build.py install && \
    deactivate && \
    # Verify installation
    ls -la /usr/share/postgresql/16/extension/pgai* || true && \
    ls -la /usr/lib/postgresql/16/lib/pgai* || true && \
    # Clean up
    cd / && \
    rm -rf /tmp/pgai

# Install pg_cron
RUN apt-get update && apt-get install -y postgresql-16-cron && \
    rm -rf /var/lib/apt/lists/*

# Install http extension
RUN git clone https://github.com/pramsey/pgsql-http.git && \
    cd pgsql-http && \
    make && \
    make install

# Install Rust toolchain for pg_tiktoken
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable && \
    rustup default stable

# Install pg_tiktoken with correct cargo-pgrx version (RELEASE MODE)
# Using alexpaden fork with 650x performance improvements via encoder caching
RUN cargo install cargo-pgrx --version 0.12.6 --locked && \
    cargo pgrx init --pg16 /usr/bin/pg_config && \
    cd /tmp && \
    git clone https://github.com/alexpaden/pg_tiktoken && \
    cd pg_tiktoken && \
    # Install in RELEASE mode for performance (not debug mode)
    cargo pgrx install --release --pg-config /usr/bin/pg_config && \
    rm -rf /tmp/pg_tiktoken

# Create configuration snippet for entrypoint script (preload)
RUN echo "shared_preload_libraries = 'pg_cron','pgvector','http','pg_tiktoken'" > /docker-entrypoint-initdb.d/99_preload_config.conf && \
    echo "cron.database_name = 'neynar_parquet_importer'" >> /docker-entrypoint-initdb.d/99_preload_config.conf

# Create configuration snippet for entrypoint script (performance)
RUN echo "max_connections = 250" > /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "shared_buffers = '16GB'" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "effective_cache_size = '48GB'" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "maintenance_work_mem = '4GB'" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "checkpoint_completion_target = 0.9" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "wal_buffers = '64MB'" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "random_page_cost = 1.1" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "effective_io_concurrency = 300" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "work_mem = '256MB'" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "min_wal_size = '8GB'" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "max_wal_size = '32GB'" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "max_worker_processes = 48" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "max_parallel_workers_per_gather = 16" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "max_parallel_workers = 48" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "max_parallel_maintenance_workers = 16" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "parallel_leader_participation = on" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "parallel_tuple_cost = 0.05" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "parallel_setup_cost = 500.0" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "min_parallel_table_scan_size = '8MB'" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "min_parallel_index_scan_size = '512kB'" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "default_statistics_target = 1000" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "constraint_exclusion = on" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "enable_seqscan = on" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "enable_partitionwise_join = on" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "enable_partitionwise_aggregate = on" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "jit = on" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "huge_pages = try" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "dynamic_shared_memory_type = posix" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "vacuum_cost_delay = 2" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "vacuum_cost_limit = 2000" >> /docker-entrypoint-initdb.d/98_performance_config.conf && \
    echo "statement_timeout = 0" >> /docker-entrypoint-initdb.d/98_performance_config.conf

# Expose PostgreSQL port
EXPOSE 5432